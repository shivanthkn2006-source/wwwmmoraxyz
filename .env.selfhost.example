# Copy to .env.production (or paste into Cloudflare Pages build variables)
# to point the app at YOUR OWN Supabase project instead of the managed backend.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>
VITE_SUPABASE_PROJECT_ID=<your-project-ref>
